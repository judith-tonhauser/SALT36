// PL observes an interrogative and returns a distribution over PAs based on the
// utility for the speaker of having uttered that interrogative to inquire about
// the goal based on the PA

var PL = function(interrogative,prior,qudBias) {
  Infer({model: function() {
    var goal = goalPrior(qudBias)
    var PA = PAprior()
    observe(speaker(goal,PA,prior), interrogative)
    //     return {goal: goal, PA}
    return PA
  }})
}

// viz.table(PL("does-cole-know?"))
// viz.table(PL("does-cole-think?"))
// viz.table(PL("does-charley-speak?"))

// lookupState samples the distribution over PAs returned by the pragmaticListener who
// observed an interrogative and returns the distribution over CC and BEL

var lookupState = function(interrogative,qudBias,prior) {
  Infer({model: function() {
    var PA = sample(PL(interrogative,prior,qudBias))
    var state = statePrior(prior)
    var stringPA = stringify(PA)
    var stringState = stringify(state)
    condition(stringPA.includes(stringState))
    var CC = state.CC
    var BEL = state.BEL
    return {CC, BEL}
    // return CC
  }})
}

